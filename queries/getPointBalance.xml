<query id="getPointBalance" action="select">
	<tables>
		<table name="lodging_point" />
	</tables>
	<columns>
		<column name="sum(amount)" alias="balance" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" var="member_srl" filter="number" notnull="notnull" />
	</conditions>
</query>
