<query id="getReviewList" action="select">
	<tables>
		<table name="lodging_review" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="property_srl" var="property_srl" filter="number" notnull="notnull" />
		<condition operation="equal" column="status" var="status" pipe="and" />
	</conditions>
	<navigation>
		<index var="sort_index" default="review_srl" order="desc" />
		<list_count var="list_count" default="10" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
