<query id="incrementCouponUsed" action="update">
	<tables>
		<table name="lodging_coupon" />
	</tables>
	<columns>
		<column name="used_count" var="used_count" default="plus(1)" />
	</columns>
	<conditions>
		<condition operation="equal" column="coupon_srl" var="coupon_srl" filter="number" notnull="notnull" />
	</conditions>
</query>
