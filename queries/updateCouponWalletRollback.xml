<query id="updateCouponWalletRollback" action="update">
	<tables>
		<table name="lodging_coupon_wallet" />
	</tables>
	<columns>
		<column name="status" var="status" default="available" />
		<column name="booking_srl" var="reset_booking_srl" filter="number" default="0" />
		<column name="used_date" var="used_date" />
	</columns>
	<conditions>
		<condition operation="equal" column="booking_srl" var="booking_srl" filter="number" notnull="notnull" />
	</conditions>
</query>
