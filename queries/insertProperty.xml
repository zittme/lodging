<query id="insertProperty" action="insert">
	<tables>
		<table name="lodging_property" />
	</tables>
	<columns>
		<column name="property_srl" var="property_srl" filter="number" notnull="notnull" />
		<column name="module_srl" var="module_srl" filter="number" notnull="notnull" />
		<column name="vendor_srl" var="vendor_srl" filter="number" default="0" />
		<column name="title" var="title" notnull="notnull" />
		<column name="summary" var="summary" />
		<column name="description" var="description" />
		<column name="property_type" var="property_type" default="motel" />
		<column name="address" var="address" />
		<column name="address_detail" var="address_detail" />
		<column name="phone" var="phone" />
		<column name="checkin_time" var="checkin_time" default="1500" />
		<column name="checkout_time" var="checkout_time" default="1100" />
		<column name="amenities" var="amenities" />
		<column name="latitude" var="latitude" />
		<column name="longitude" var="longitude" />
		<column name="notify_email" var="notify_email" />
		<column name="allow_onsite_pay" var="allow_onsite_pay" default="Y" />
		<column name="allow_prepay" var="allow_prepay" default="Y" />
		<column name="status" var="status" default="open" />
		<column name="list_order" var="list_order" filter="number" default="0" />
		<column name="regdate" var="regdate" />
		<column name="last_update" var="last_update" />
	</columns>
</query>
