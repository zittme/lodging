<query id="getCouponUseCount" action="select">
	<tables>
		<table name="lodging_coupon_use" />
	</tables>
	<columns>
		<column name="count(*)" alias="count" />
	</columns>
	<conditions>
		<condition operation="equal" column="coupon_srl" var="coupon_srl" filter="number" notnull="notnull" />
		<condition operation="equal" column="member_srl" var="member_srl" filter="number" notnull="notnull" pipe="and" />
	</conditions>
</query>
